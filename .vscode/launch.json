{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cold Mailer: isolated desktop",
            "type": "debugpy",
            "request": "launch",
            "module": "cold_mailer.ui",
            "args": ["--data-dir", "${workspaceFolder}/reports/debug-profile"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Cold Mailer: isolated CLI diagnostics",
            "type": "debugpy",
            "request": "launch",
            "module": "cold_mailer",
            "args": ["--data-dir", "${workspaceFolder}/reports/debug-profile", "diagnostics"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
